.DS_Store

# the book PDFs are copyrighted: they stay local, never on GitHub or the site
books/*/*.pdf

# tools/: dependencies, screenshots, and extracted book text (copyrighted, like the PDFs)
node_modules/
.venv/
.logs/
tools/.shots/
tools/.text/

__pycache__/
# videos and their scripts stay off GitHub; videos/ has its own local-only git repo for the scripts
videos/
tools/video/models/
tools/video/.logs/
tools/video/node_modules/
